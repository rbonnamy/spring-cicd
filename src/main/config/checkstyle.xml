<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <!-- Gravité par défaut : warning au lieu de error pour ne pas bloquer bêtement le build -->
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- Vérifie que les fichiers se terminent par une nouvelle ligne -->
    <module name="NewlineAtEndOfFile"/>

    <!-- Pas de tabulations, uniquement des espaces -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="TreeWalker">

        <!-- ================================================================= -->
        <!--  RÈGLES JAVADOC (Incluses et configurées intelligemment)          -->
        <!-- ================================================================= -->

        <!-- Exige une Javadoc sur les classes/interfaces publiques et protégées -->
        <module name="JavadocType">
            <property name="scope" value="protected"/>
        </module>

        <!-- Exige une Javadoc sur les méthodes publiques et protégées -->
        <!-- Tolère l'absence de Javadoc si la méthode a l'annotation @Override -->
        <module name="JavadocMethod">
            <property name="scope" value="protected"/>
            <property name="allowedAnnotations" value="Override, Test, Bean"/>
        </module>

        <!-- Exige une Javadoc pour les variables (ex: constantes publiques) -->
        <module name="JavadocVariable">
            <property name="scope" value="protected"/>
        </module>

        <!-- Vérifie la bonne mise en forme de la Javadoc -->
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="false"/> <!-- Ne force pas le point final à la 1ère phrase -->
        </module>


        <!-- ================================================================= -->
        <!--  RÈGLES DE CODAGE INDULGENTES (Garde le code propre mais flexible)-->
        <!-- ================================================================= -->

        <!-- Interdit les imports avec .* (ex: import java.util.*;) -->
        <module name="AvoidStarImport"/>

        <!-- Supprime les imports inutilisés -->
        <module name="UnusedImports"/>

        <!-- Conventions de nommage de base (Classes, Méthodes, Variables) -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>

        <!-- Évite les blocs vides (ex: un catch d'exception sans rien dedans) -->
        <module name="EmptyBlock"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>

        <!-- Force l'utilisation d'accolades même pour les 'if' sur une seule ligne -->
        <module name="NeedBraces"/>

        <!-- Modificateurs dans le bon ordre (ex: public static final, pas final public static) -->
        <module name="ModifierOrder"/>

        <!-- Évite de redéfinir une variable qui porte le même nom qu'un attribut (hors constructeurs/setters) -->
        <module name="HiddenField">
            <property name="ignoreConstructorParameter" value="true"/>
            <property name="ignoreSetter" value="true"/>
        </module>

        <!-- Permet les annotations de suppression à l'intérieur du code si besoin -->
        <module name="SuppressWarningsHolder" />

    </module>

    <!-- Permet d'utiliser le filtre de suppression -->
    <module name="SuppressWarningsFilter" />
</module>
